{
  "name": "Siguri",
  "description": "Extension Siguri",
  "version": "1.2.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Siguri Extension",
    "default_icon": "medias/logo.png"
  },
  "icons": {
    "16": "medias/favicon-16x16.png",
    "32": "medias/favicon-32x32.png",
    "64": "medias/favicon-64x64.png",
    "192": "medias/favicon-192x192.png",
    "512": "medias/favicon-512x512.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "medias/logo.png"
      ],
      "matches": [
        "*://*.happykiller.net/*"
      ]
    }
  ],
  "optional_permissions": []
}