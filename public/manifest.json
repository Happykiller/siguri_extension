{
  "name": "Siguri",
  "description": "Extension Siguri",
  "version": "0.6.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "./popup/index.html",
    "default_title": "Siguri Extension",
    "default_icon": "./medias/icon_extensions.png"
  },
  "icons": {
    "16": "./medias/icon_extensions.png",
    "48": "./medias/icon_extensions.png",
    "128": "./medias/icon_extensions.png"
  },
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "*://*.happykiller.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [ "medias/logo.png" ],
      "matches": [
        "*://*.happykiller.net/*"
      ]
    }
  ],
  "optional_permissions": []
}